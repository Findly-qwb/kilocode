{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kilo",
  "version": "0.1.0",
  "identifier": "ai.kilo.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kilo",
        "width": 1240,
        "height": 820,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/kilo"],
    "resources": ["binaries/tree-sitter/**/*", "binaries/ffmpeg/**/*", "binaries/kilo-sandbox-mutation-worker.js"]
  }
}
